<?xml version="1.0" encoding="UTF-8"?>

<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="Lab2PU" transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <jta-data-source>non-jta-data-source</jta-data-source>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://${DB_HOST}/${DB_NAME}"/>
            <property name="jakarta.persistence.jdbc.user" value="${APP_USER}"/>
            <property name="jakarta.persistence.jdbc.password" value="${APP_PASSWORD}"/>
            <property name="jakarta.persistence.lock.timeout" value="100"/>
            <property name="jakarta.persistence.query.timeout" value="100"/>
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="org.hibernate.flushMode" value="COMMIT"/>
            <property name="org.hibernate.cacheable" value="true"/>
        </properties>
    </persistence-unit>
</persistence>